    "pinnedDeckBuildResult": {
      "description": "Audit DTO only. It never grants pinned-deck authority; the trusted deck owner must build and revalidate the authority from the verified contract set.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "reason_code",
        "pinned_deck"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "reason_code": {
          "enum": [
