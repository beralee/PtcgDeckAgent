    },
    "initialDeckResolution": {
      "description": "Audit DTO only. It is never accepted as deck-selection authority; the trusted deck owner must recompute from the exact verified pinned authority and raw candidate outcome.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "selected_card_ids",
        "owner",
        "reason_code",
        "candidate_reason_code",
        "fallback_branch",
        "deck_hash"
      ],
      "properties": {
