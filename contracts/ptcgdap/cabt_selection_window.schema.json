            "deck_card_not_exact_int",
            "deck_card_not_positive",
            "deck_mismatch",
            "deck_exception",
            "deck_timeout",
            "deck_unavailable"
          ]
        },
        "fallback_branch": {
          "oneOf": [
            {
              "const": "pinned_verified_deck"
            },
            {
              "type": "null"
            }
          ]
        },
        "deck_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "accepted": {
              "const": false
            },
            "selected_card_ids": {
              "maxItems": 0
            },
            "owner": {
              "const": "none"
            },
            "reason_code": {
              "const": "invalid_pinned_deck"
            },
            "candidate_reason_code": {
              "const": "invalid_pinned_deck"
            },
            "fallback_branch": {
              "type": "null"
            },
            "deck_hash": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "accepted": {
              "const": true
            },
            "selected_card_ids": {
              "minItems": 60,
              "maxItems": 60
            },
            "owner": {
              "const": "initial_candidate"
            },
            "reason_code": {
              "const": "pinned_deck_accepted"
            },
            "candidate_reason_code": {
              "const": "pinned_deck_accepted"
            },
            "fallback_branch": {
              "type": "null"
            },
            "deck_hash": {
              "const": "F7CDD0968318B4D10D7FE7AB196FA24F86626DC23CF32432D7E2A7D64050A4E8"
            }
          }
        },
        {
          "properties": {
            "accepted": {
              "const": true
            },
            "selected_card_ids": {
              "minItems": 60,
              "maxItems": 60
            },
            "owner": {
              "const": "pinned_deck_fallback"
            },
            "reason_code": {
              "const": "pinned_deck_fallback"
            },
            "candidate_reason_code": {
              "enum": [
                "deck_not_list",
                "deck_cardinality",
                "deck_card_not_exact_int",
                "deck_card_not_positive",
