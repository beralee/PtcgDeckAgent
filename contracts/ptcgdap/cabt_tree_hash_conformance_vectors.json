      "left": "token-free-search-alpha",
      "right": "token-free-search-empty-string",
      "reason": "An empty string still means capability present"
    },
    {
      "kind": "different_hash",
      "left": "raw-private-search-alpha",
      "right": "raw-private-search-beta",
      "reason": "The raw-private domain binds the real token"
    },
    {
      "kind": "different_hash",
      "left": "token-free-search-alpha",
      "right": "token-free-unknown-root-changed",
      "reason": "Additive unknown values remain in the Host-private binding"
    },
    {
      "kind": "different_hash",
      "left": "token-free-search-alpha",
      "right": "token-free-search-null",
      "reason": "Search capability presence is binding data"
    },
    {
      "kind": "equal_hash",
      "left": "public-projection-from-unknown-mode-1",
