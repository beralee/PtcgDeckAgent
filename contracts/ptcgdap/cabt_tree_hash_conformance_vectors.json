  "profile_id": "cabt_tree_hash_v1",
  "authority": {
    "canonicalization": "RFC 8785 JSON Canonicalization Scheme (JCS) byte-generation rules on the constrained CABT input profile described by profile_scope",
    "number_vectors": "RFC 8785 Appendix B, complete Table 1",
    "domain_contract": "contracts/ptcgdap/cabt_tree_hash_profile.json",
    "profile_scope": "RFC 8785 canonical output over the CABT profile's I-JSON character subset. Strict JSON bytes never accept a leading UTF-8 BOM. Python integer nodes are additionally restricted to -(2^53-1)..(2^53-1) and are never coerced to binary64."
  },
  "search_token_policy": "All non-null Search values in this artifact are synthetic labels; no real search_begin_input token is persisted.",
  "limits": {
    "max_input_bytes": 67108864,
    "max_depth": 128,
    "max_nodes": 1000000,
    "max_output_bytes": 67108864,
    "safe_integer_min": -9007199254740991,
    "safe_integer_max": 9007199254740991
  },
