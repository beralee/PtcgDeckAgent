                  "error_code",
                  "audit"
                ],
                "properties": {
                  "accepted": {
                    "type": "boolean"
                  },
                  "error_code": {
                    "type": "string",
                    "enum": [
                      "",
                      "binding_contract_error",
                      "invalid_port",
                      "snapshot_not_current",
                      "snapshot_owner_mismatch",
                      "snapshot_integrity_invalid",
                      "source_mutated",
                      "invalid_window",
                      "window_mismatch",
                      "invalid_callback_binding_hash",
                      "invalid_private_commands",
                      "invalid_private_object_refs",
                      "reference_released",
                      "binding_not_current",
                      "option_index_invalid",
                      "binding_integrity_invalid",
                      "owner_mismatch"
                    ]
                  },
                  "audit": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "binding_profile",
                          "binding_version",
                          "snapshot_id",
                          "window_id",
                          "option_index",
                          "fingerprint_hash",
                          "authority",
                          "authoritative"
                        ],
                        "properties": {
                          "binding_profile": {
                            "const": "ptcgdap-godot-option-binding-p3-wp2-v1"
                          },
                          "binding_version": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "snapshot_id": {
                            "type": "string",
                            "pattern": "^[A-F0-9]{64}$"
                          },
                          "window_id": {
                            "type": "string",
                            "pattern": "^[A-F0-9]{64}$"
                          },
                          "option_index": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "fingerprint_hash": {
                            "type": "string",
                            "pattern": "^[A-F0-9]{64}$"
                          },
                          "authority": {
                            "const": "godot_option_resolution_shadow"
                          },
                          "authoritative": {
                            "const": false
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "transition_cases": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
