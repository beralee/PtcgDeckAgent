{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptcgdap.local/contracts/policy_package_v1.schema.json",
  "title": "PTCGDAP immutable local policy package manifest v1",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "package_id",
    "package_version",
    "authority_scope",
    "target",
    "author_package",
    "contracts",
    "executor",
    "model",
    "trace",
    "capabilities",
    "fallback",
    "parents",
    "rollback"
  ],
  "properties": {
    "document_type": {"const": "policy_package_v1"},
    "schema_version": {"const": 1},
    "package_id": {"const": "ptcgdap.marnie.windows-local.policy"},
    "package_version": {"const": "0.1.0"},
    "authority_scope": {"const": "development_and_device_canary_only"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "platform", "architecture", "execution_location"],
      "properties": {
        "host": {"const": "godot"},
        "platform": {"const": "windows"},
        "architecture": {"const": "x86_64"},
        "execution_location": {"const": "device_local"}
      }
    },
    "author_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "package_id", "package_version", "archive_sha256", "manifest_sha256",
        "deck_manifest_sha256", "policy_ir_sha256", "adapter_sha256", "config_sha256", "weights"
      ],
      "properties": {
        "path": {"const": "data/ptcgdap/author_strategy_packages/ptcgdap-author-strategy-release-candidate.ptcgai"},
        "package_id": {"const": "ptcgdap.marnie.windows-local"},
        "package_version": {"const": "0.1.0"},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "deck_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "policy_ir_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "status"],
          "properties": {
            "path": {"const": "policy/weights.bin"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "status": {"const": "unused_non_model_payload"}
          }
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cabt_contract_canonical_sha256", "card_catalog_bundle_canonical_sha256",
        "base_executor_bundle_canonical_sha256", "public_deck_adapter_bundle_canonical_sha256",
        "strategic_trace_v2_bundle_canonical_sha256", "source_lock_canonical_sha256"
      ],
      "properties": {
        "cabt_contract_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "card_catalog_bundle_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "base_executor_bundle_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "public_deck_adapter_bundle_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "strategic_trace_v2_bundle_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "source_lock_canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "portable_baseline", "host_adapter_path", "host_adapter_sha256",
        "base_executor_path", "base_executor_sha256", "match_owner_path", "match_owner_sha256",
        "engine_action_executor_path", "engine_action_executor_sha256", "policy_boundary"
      ],
      "properties": {
        "kind": {"const": "gdscript_restricted_ir_v1"},
        "portable_baseline": {"const": "gdscript"},
        "host_adapter_path": {"const": "scripts/ai/ptcgdap/runtime/local/AuthorStrategyDevelopmentPolicy.gd"},
        "host_adapter_sha256": {"$ref": "#/$defs/sha256"},
        "base_executor_path": {"const": "scripts/ai/ptcgdap/public/RestrictedBaseGraphExecutor.gd"},
        "base_executor_sha256": {"$ref": "#/$defs/sha256"},
        "match_owner_path": {"const": "scripts/ai/ptcgdap/host/godot/PtcgDAPAuthorDevelopmentBattleOwner.gd"},
        "match_owner_sha256": {"$ref": "#/$defs/sha256"},
        "engine_action_executor_path": {"const": "scripts/ai/ptcgdap/host/godot/AuthorStrategyEngineActionExecutor.gd"},
        "engine_action_executor_sha256": {"$ref": "#/$defs/sha256"},
        "policy_boundary": {"const": "agent(raw_observation)->list[int]"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learned_model", "backend", "artifact_path", "artifact_sha256", "unexpected_fallback_expected"],
      "properties": {
        "learned_model": {"const": "none"},
        "backend": {"const": "none"},
        "artifact_path": {"type": "null"},
        "artifact_sha256": {"type": "null"},
        "unexpected_fallback_expected": {"const": 0}
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "bundle_canonical_sha256"],
      "properties": {
        "profile": {"const": "strategic_trace_v2"},
        "bundle_canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cabt_search", "seeded_offline", "card_id_domain", "cabt_exportable", "network_ingress",
        "network_egress", "system_python", "external_process", "dynamic_model_download", "policy_output"
      ],
      "properties": {
        "cabt_search": {"const": "none"},
        "seeded_offline": {"const": false},
        "card_id_domain": {"const": "godot_local_card_uid_v1"},
        "cabt_exportable": {"const": false},
        "network_ingress": {"const": false},
        "network_egress": {"const": false},
        "system_python": {"const": false},
        "external_process": {"const": false},
        "dynamic_model_download": {"const": false},
        "policy_output": {"const": "current_window_indexes_only"}
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "mode", "remote", "classic_raw_state"],
      "properties": {
        "owner": {"const": "restricted_base_graph"},
        "mode": {"const": "deterministic_same_window"},
        "remote": {"const": false},
        "classic_raw_state": {"const": false}
      }
    },
    "parents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author_package_bundle_canonical_sha256", "author_match_host_bundle_canonical_sha256",
        "author_live_seam_bundle_canonical_sha256", "author_release_bundle_canonical_sha256",
        "source_lock_canonical_sha256"
      ],
      "properties": {
        "author_package_bundle_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "author_match_host_bundle_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "author_live_seam_bundle_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "author_release_bundle_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "source_lock_canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "target_kind", "target_path", "target_canonical_sha256",
        "current_match_hot_swap", "user_packages_preserved"
      ],
      "properties": {
        "mode": {"const": "disable_author_strategy_for_new_matches"},
        "target_kind": {"const": "author_strategy_disabled_release_profile"},
        "target_path": {"const": "contracts/ptcgdap/author_strategy_release_profile.json"},
        "target_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "current_match_hot_swap": {"const": false},
        "user_packages_preserved": {"const": true}
      }
    }
  }
}
