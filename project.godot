; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="PtcgDeckAgent"
config/description="宝可梦集换式卡牌练牌模拟器"
config/version="0.5.4"
run/main_scene="res://scenes/main_menu/MainMenu.tscn"
config/features=PackedStringArray("4.6")

[autoload]

AuthorStrategyPackageCatalog="*res://scripts/ai/ptcgdap/packages/AuthorStrategyPackageCatalog.gd"
BattleMusicManager="*res://scripts/autoload/BattleMusicManager.gd"
CardDatabase="*res://scripts/autoload/CardDatabase.gd"
PtcgDAPWindowsExportMatchEntrypoint="*res://scripts/tools/run_ptcgdap_windows_export_match.gd"
PtcgDAPWindowsUiMatchEntrypoint="*res://scripts/tools/run_ptcgdap_windows_ui_match.gd"
FontBootstrap="*res://scripts/autoload/FontBootstrap.gd"
GameManager="*res://scripts/autoload/GameManager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/size/window_width=1600
window/size/window_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/web_release_post_export/plugin.cfg")

[internationalization]

locale/default="zh_CN"

[network]

tls/certificate_bundle_override="res://data/certs/cacert.pem"

[ptcgdap]

author_strategy/enabled=true
strategy_platform/base_url="https://api.ptcg.skillserver.cn"
strategy_platform/ranking_profile_id="godot_v18_ladder_v1"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
