const FeatureGateScript = preload("res://scripts/ai/ptcgdap/packages/AuthorStrategyFeatureGate.gd")


static func evaluate_selection(selection: Dictionary, platform_name: String = "") -> Dictionary:
	if not FeatureGateScript.is_enabled():
		return _error("author_strategy_feature_disabled")
	var platform := platform_name if not platform_name.is_empty() else OS.get_name()
	if platform != "Windows":
		return _error("development_platform_not_authorized")
	var candidate := candidate_for_selection(selection)
	if candidate.is_empty():
		return _error("development_candidate_not_authorized")
	return {
		"ok": true,
		"error_code": "",
		"package_id": candidate.get("package_id"),
		"package_version": candidate.get("package_version"),
		"archive_sha256": candidate.get("archive_sha256"),
		"install_source": candidate.get("install_source"),
		"source_deck_id": candidate.get("source_deck_id"),
		"card_id_domain": CARD_ID_DOMAIN,
		"development_execution_only": true,
		"production_ready": false,
		"android_ready": false,
	}


static func request_match_handle(
	catalog: Variant,
	selection: Dictionary,
	platform_name: String = ""
) -> Dictionary:
	var admitted := evaluate_selection(selection, platform_name)
	if not bool(admitted.get("ok", false)):
		return {"ok": false, "error_code": admitted.get("error_code"), "handle": null}
	if catalog == null or not catalog.has_method("request_match_handle"):
		return {"ok": false, "error_code": "package_catalog_unavailable", "handle": null}
	var requested: Variant = catalog.call(
		"request_match_handle",
		admitted.get("package_id"),
		admitted.get("package_version"),
		admitted.get("archive_sha256")
	)
	if not requested is Dictionary:
		return {"ok": false, "error_code": "package_integrity_invalid", "handle": null}
	var result: Dictionary = requested
	if not bool(result.get("ok", false)):
		return {
			"ok": false,
			"error_code": str(result.get("error_code", "package_integrity_invalid")),
			"handle": null,
		}
	var handle: Variant = result.get("handle")
	if handle == null or not handle.has_method("validate_integrity") or not handle.validate_integrity():
		return {"ok": false, "error_code": "package_integrity_invalid", "handle": null}
	var pin_error := validate_handle_pins(handle.to_public_dict())
	if not pin_error.is_empty():
		return {"ok": false, "error_code": pin_error, "handle": null}
	return {
		"ok": true,
		"error_code": "",
		"handle": handle,
		"source_deck_id": admitted.get("source_deck_id"),
		"development_execution_only": true,
		"production_ready": false,
	}


static func validate_handle_pins(pins: Dictionary) -> String:
	var candidate := candidate_for_pins(pins)
	if (
		candidate.is_empty()
		or pins.get("source_deck_id") != candidate.get("source_deck_id")
		or pins.get("deck_card_id_domain") != CARD_ID_DOMAIN
		or pins.get("deck_platform_scope") != ["windows"]
		or pins.get("local_deck_card_count") != 60
		or pins.get("local_deck_unique_printing_count") != candidate.get("unique_printing_count")
		or pins.get("cabt_exportable") != false
		or pins.get("signature_status") != "test_fixture_trusted"
		or pins.get("development_shadow_ready") != true
		or pins.get("execution_trusted") != false
		or pins.get("live_authority") != false
	):
		return "development_candidate_not_authorized"
	return ""


static func candidate_for_selection(selection: Dictionary) -> Dictionary:
	for candidate: Dictionary in CANDIDATES:
		if (
			selection.get("package_id") == candidate.get("package_id")
			and selection.get("package_version") == candidate.get("package_version")
			and str(selection.get("archive_sha256", "")).to_upper() == candidate.get("archive_sha256")
			and selection.get("install_source") == candidate.get("install_source")
		):
			return candidate
	return {}


static func candidate_for_package_identity(package_id: String, package_version: String) -> Dictionary:
	for candidate: Dictionary in CANDIDATES:
		if (
			candidate.get("package_id") == package_id
			and candidate.get("package_version") == package_version
		):
			return candidate
	return {}


static func candidate_for_pins(pins: Dictionary) -> Dictionary:
	for candidate: Dictionary in CANDIDATES:
		if (
			pins.get("package_id") == candidate.get("package_id")
			and pins.get("package_version") == candidate.get("package_version")
			and str(pins.get("archive_sha256", "")).to_upper() == candidate.get("archive_sha256")
		):
			return candidate
	return {}


static func _error(code: String) -> Dictionary:
	return {
		"ok": false,
		"error_code": code,
		"source_deck_id": -1,
		"development_execution_only": false,
		"production_ready": false,
		"android_ready": false,
	}
