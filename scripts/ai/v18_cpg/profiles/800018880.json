{
  "profile_version": 2,
  "semantic_version": 1,
  "risk_posture": "balanced",
  "switch_margin": 70.0,
  "expected_regret_threshold": 60.0,
  "initial_response_token_budget": 420,
  "delta_response_token_budget": 170,
  "turn_visible_wait_budget_ms": 6500,
  "cold_request_estimate_ms": 5000,
  "max_policy_nodes": 7,
  "protected_roles": [
    "partner_piece",
    "signature_piece",
    "evolution_piece",
    "stage2_dependency",
    "energy_source",
    "trainer_plan_piece",
    "recovery",
    "bench_space"
  ],
  "strategic_priorities": [
    {
      "priority": 1,
      "goal": "minimum_resource_ko",
      "when_all": [{"fact": "attack.ko_available", "op": "==", "value": true}],
      "prefer_routes": ["route:attack_ko", "route:gust"],
      "avoid_routes": ["route:information", "route:develop", "route:end_turn"],
      "preserve_roles": ["energy_source", "trainer_plan_piece", "recovery"]
    },
    {
      "priority": 2,
      "goal": "route_completion",
      "when_all": [{"fact": "attack.ready", "op": "==", "value": false}],
      "prefer_routes": ["route:evolve", "route:information", "route:energy_commit", "route:develop"],
      "avoid_routes": ["route:end_turn"],
      "preserve_roles": ["stage2_dependency", "signature_piece", "trainer_plan_piece"]
    },
    {
      "priority": 3,
      "goal": "information_before_commitment",
      "when_all": [
        {"fact": "information.material_action_available", "op": "==", "value": true},
        {"fact": "attack.ko_available", "op": "==", "value": false}
      ],
      "prefer_routes": ["route:information", "route:evolve", "route:develop"],
      "avoid_routes": ["route:end_turn"],
      "preserve_roles": ["trainer_plan_piece", "stage2_dependency", "energy_source"]
    },
    {
      "priority": 4,
      "goal": "typed_energy_continuity",
      "when_all": [{"fact": "turn.energy_available", "op": "==", "value": true}],
      "prefer_routes": ["route:energy_commit", "route:evolve"],
      "avoid_routes": ["route:develop"],
      "preserve_roles": ["energy_source", "stage2_dependency"]
    },
    {
      "priority": 5,
      "goal": "low_deck_safety",
      "when_all": [{"fact": "resources.deck_low", "op": "==", "value": true}],
      "prefer_routes": ["route:attack_ko", "route:attack_pressure", "route:pivot"],
      "avoid_routes": ["route:information", "route:opening_search", "route:develop"],
      "preserve_roles": ["recovery", "energy_source", "trainer_plan_piece"]
    }
  ],
  "route_preferences": {
    "model_consideration_margin": 350.0,
    "route_biases": {
      "route:attack_ko": 290.0,
      "route:attack_pressure": 120.0,
      "route:evolve": 220.0,
      "route:information": 130.0,
      "route:energy_commit": 150.0,
      "route:develop": 100.0,
      "route:pivot": 100.0,
      "route:end_turn": -250.0
    },
    "ready_ko_order": ["route:attack_ko", "route:gust", "route:attack_pressure"],
    "attackless_order": ["route:evolve", "route:information", "route:energy_commit", "route:develop", "route:pivot"],
    "avoid_after_ko_secured": ["route:information", "route:develop", "route:opening_search"]
  },
  "safety": {
    "max_switch_gap": 110.0,
    "block_search_when_deck_low": true,
    "low_deck_threshold": 8,
    "critical_deck_threshold": 5,
    "preserve_bench_slots": 1,
    "stop_optional_draw_when_attack_ready": true,
    "reject_information_churn_after_ko_secured": true
  },
  "module_parameters": {
    "partner_chain": {
      "attack_cost_by_uid": {
        "CSV10C_030": ["R"]
      }
    },
    "cycle_pivot": {
      "enabled_guards": ["optional_engine", "typed_energy", "ready_ko", "bench_reserve", "low_deck"],
      "optional_draw_engine_uids": ["CSV8C_135"],
      "primary_required_energy": ["R"],
      "primary_attacker_uids": ["CSV10C_030"],
      "attacker_root_uids": ["CSV10C_028", "CSV10C_029"],
      "minimum_hand_for_optional_engine": 4,
      "reserve_bench_slots": 1,
      "low_deck_floor": 8,
      "block_optional_engine_when_attack_ready": true,
      "block_optional_engine_when_energy_attachment_open": true,
      "block_off_color_primary_attachment": true
    }
  }
}
