func test_all_imported_18_decks_obey_pokemon_deck_construction_rules() -> String:
	var checks: Array[String] = []
	for deck_id: int in ALL_IMPORTED_18_DECK_IDS:
		var deck := _load_bundled_deck(deck_id)
		checks.append(assert_not_null(deck, "Imported 18.0 deck %d should load before construction checks" % deck_id))
		if deck == null:
			continue
		checks.append(assert_eq(_deck_total(deck), 60, "Imported 18.0 deck %d must contain exactly 60 cards" % deck_id))
		var name_counts := {}
		var ace_spec_count := 0
		var radiant_count := 0
		var basic_pokemon_count := 0
		for entry: Dictionary in deck.cards:
			var card: CardData = CardDatabase.get_card(str(entry.get("set_code", "")), str(entry.get("card_index", "")))
			checks.append(assert_not_null(card, "Imported 18.0 deck %d entry should resolve for construction checks" % deck_id))
			if card == null:
				continue
			var count := int(entry.get("count", 0))
			if card.card_type != "Basic Energy":
				var card_name := card.display_name()
				name_counts[card_name] = int(name_counts.get(card_name, 0)) + count
			if card.is_ace_spec():
				ace_spec_count += count
			if card.is_radiant():
				radiant_count += count
			if card.card_type == "Pokemon" and card.stage == "Basic":
				basic_pokemon_count += count
		for card_name: Variant in name_counts:
			checks.append(assert_true(int(name_counts[card_name]) <= 4, "Imported 18.0 deck %d has %d copies of %s; non-Basic-Energy cards are capped at 4" % [deck_id, int(name_counts[card_name]), str(card_name)]))
		checks.append(assert_true(ace_spec_count <= 1, "Imported 18.0 deck %d has %d ACE SPEC cards; the limit is 1" % [deck_id, ace_spec_count]))
		checks.append(assert_true(radiant_count <= 1, "Imported 18.0 deck %d has %d Radiant Pokemon; the limit is 1" % [deck_id, radiant_count]))
		checks.append(assert_true(basic_pokemon_count > 0, "Imported 18.0 deck %d must contain at least one Basic Pokemon" % deck_id))
	return run_checks(checks)


