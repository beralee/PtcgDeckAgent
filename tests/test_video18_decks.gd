		assert_eq(_entry_count(deck, "CSVSC_005"), 4, "Both source Toedscool prints should rebuild as four copies of CSVSC 005"),
		assert_eq(_source_entry_count(deck, "PAR_16"), 3, "The original PAR 016 three-copy slot should be preserved"),
		assert_eq(_source_entry_count(deck, "SCR_17"), 1, "The original SCR 017 one-copy slot should be preserved"),
	])


func _deck_total(deck: DeckData) -> int:
	if deck == null:
		return 0
	var total := 0
	for entry: Dictionary in deck.cards:
		total += int(entry.get("count", 0))
	return total


func _entry_count(deck: DeckData, ref: String) -> int:
	if deck == null:
		return 0
	var total := 0
	for entry: Dictionary in deck.cards:
		var entry_ref := "%s_%s" % [str(entry.get("set_code", "")), str(entry.get("card_index", ""))]
		if entry_ref == ref:
			total += int(entry.get("count", 0))
	return total


func _source_entry_count(deck: DeckData, ref: String) -> int:
	if deck == null:
		return 0
	var total := 0
	for entry: Dictionary in deck.cards:
		var entry_ref := "%s_%s" % [str(entry.get("source_set_code", "")), str(entry.get("source_card_index", ""))]
		if entry_ref == ref:
			total += int(entry.get("count", 0))
	return total


func _load_bundled_deck(deck_id: int) -> DeckData:
	var path := "res://data/bundled_user/decks/%d.json" % deck_id
	if not FileAccess.file_exists(path):
		return null
	var raw: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if not (raw is Dictionary):
		return null
	return DeckData.from_dict(raw as Dictionary)
