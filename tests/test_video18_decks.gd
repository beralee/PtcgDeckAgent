func test_video18_decks_are_bundled_and_named_consistently() -> String:
	var manifest := FileAccess.get_file_as_string("res://data/bundled_user/_manifest.txt")
	var checks: Array[String] = []
	for raw_id: Variant in VIDEO18_DECKS.keys():
		var deck_id := int(raw_id)
		var spec: Dictionary = VIDEO18_DECKS[deck_id]
		var deck: DeckData = CardDatabase.get_deck(deck_id)
		checks.append(assert_not_null(deck, "Video 18.0 deck %d should load through CardDatabase" % deck_id))
		if deck == null:
			continue
		checks.append(assert_eq(deck.deck_name, str(spec["name"]), "Video deck %d should use its audited 18.0 name" % deck_id))
		checks.append(assert_true(deck.deck_name.begins_with("18.0 "), "Video deck %d should start with the 18.0 prefix" % deck_id))
		checks.append(assert_eq(_deck_total(deck), 60, "Video deck %d should contain exactly 60 cards" % deck_id))
		checks.append(assert_str_contains(manifest, "res://data/bundled_user/decks/%d.json" % deck_id, "Manifest should seed video deck %d" % deck_id))
	return run_checks(checks)


func test_video18_decks_build_all_instances_without_placeholders_or_unimplemented_cards() -> String:
	CardImplementationStatus.clear_cache()
	var checks: Array[String] = []
	for raw_id: Variant in VIDEO18_DECKS.keys():
		var deck_id := int(raw_id)
		var deck: DeckData = CardDatabase.get_deck(deck_id)
		var instances := CardDatabase.build_deck_instances(deck, 0) if deck != null else []
		checks.append(assert_eq(instances.size(), 60, "Video deck %d should build all 60 runtime instances" % deck_id))
		if deck == null:
			continue
		for entry: Dictionary in deck.cards:
			var set_code := str(entry.get("set_code", ""))
			var card_index := str(entry.get("card_index", ""))
			var ref := "%s_%s" % [set_code, card_index]
			checks.append(assert_false(set_code.begins_with("LEN_"), "Video deck %d must not contain English placeholder %s" % [deck_id, ref]))
			var card: CardData = CardDatabase.get_card(set_code, card_index)
			checks.append(assert_not_null(card, "Video deck %d card %s should load" % [deck_id, ref]))
			if card == null:
				continue
			checks.append(assert_false(
				CardImplementationStatus.is_unimplemented(card),
				"Video deck %d card %s should be implemented: %s" % [deck_id, ref, CardImplementationStatus.get_reason(card)]
			))
			var image_path := "res://data/bundled_user/cards/images/%s/%s.png.bin" % [set_code, card_index]
			var has_image := CardData.is_valid_card_image_file(image_path) or CardData.is_valid_card_image_file(card.image_local_path)
			checks.append(assert_true(has_image, "Video deck %d card %s should have a valid image" % [deck_id, ref]))
	return run_checks(checks)


